# Copy this file to backend/.env and fill it in. backend/.env is never committed.
PORT=4000

# Long random text (32+ characters) used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters

# The first administrator, created only when the users table is empty (password: 12+ characters).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-12-chars-min

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_traffic

# Load sample intersections, cameras, violations and alerts on the first run (set false for an empty system).
SEED_SAMPLE_DATA=true
